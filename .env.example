# ---- App (Chainlit) ----
# Port the Chainlit UI is served on
APP_PORT=8000

# ---- Agent LLM (OpenAI) ----
# provider:model string for the deep agent (gpt-4o = medium tier)
AGENT_MODEL=openai:gpt-4o
# Your OpenAI API key (required to chat)
OPENAI_API_KEY=

# ---- Embeddings (local FastEmbed, no API key needed) ----
# FastEmbed model (384-dim, runs locally on CPU)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Qdrant ----
# REST endpoint (dashboard at /dashboard)
QDRANT_URL=http://localhost:6333
# API key (also injected into the container via docker-compose)
QDRANT_API_KEY=local-dev-key
# Vector collection name
QDRANT_COLLECTION=xml_knowledge_base

# ---- RAG / ingestion ----
# Folder scanned for .xml files
RAG_DATA_DIR=data/rag
# XML tag treated as one record (leave blank = use the root's direct children)
RAG_RECORD_TAG=
# Max characters per chunk
RAG_CHUNK_SIZE=800
# Character overlap between consecutive chunks
RAG_CHUNK_OVERLAP=100
