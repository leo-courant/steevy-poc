  <regulation id="R101">
        
    <title>Maximum Engine Power per Length</title>
        
    <description>Engines may not exceed 14 kW per meter of vessel length.</description>
        
    <applicableTypes>MotorSailor, Catamaran, Yacht</applicableTypes>
        
    <effectiveDate>2022-01-01</effectiveDate>
        
    <penalty>Fine up to 5,000 USD</penalty>
      
  </regulation>
    
  <regulation id="R102">
        
    <title>Mandatory Life-Raft Capacity</title>
        
    <description>Each boat must carry a life-raft for at least 1.4 persons per meter of length.</description>
        
    <applicableTypes>All</applicableTypes>
        
    <effectiveDate>2021-06-15</effectiveDate>
        
    <penalty>Detention until compliance</penalty>
      
  </regulation>
    
  <regulation id="R103">
        
    <title>Night Navigation Light Standard</title>
        
    <description>Vessels operating at night must display approved navigation lights visible for 2 nautical miles.</description>
        
    <applicableTypes>All</applicableTypes>
        
    <effectiveDate>2023-03-10</effectiveDate>
        
    <penalty>Warning and mandatory inspection</penalty>
      
  </regulation>
    
  <regulation id="R104">
        
    <title>Harbor Speed Limit</title>
        
    <description>Boats inside regulated harbor zones must not exceed 6 knots.</description>
        
    <applicableTypes>All</applicableTypes>
        
    <effectiveDate>2020-09-01</effectiveDate>
        
    <penalty>Fine up to 2,000 USD</penalty>
      
  </regulation>
    
  <regulation id="R105">
        
    <title>Wastewater Discharge Restriction</title>
        
    <description>Discharge of untreated wastewater is prohibited within 5 nautical miles of any port.</description>
        
    <applicableTypes>All</applicableTypes>
        
    <effectiveDate>2022-08-20</effectiveDate>
        
    <penalty>Environmental surcharge and detention</penalty>
      
  </regulation>
    
  <regulation id="R106">
        
    <title>Navigation Electronics Redundancy</title>
        
    <description>Vessels over 20 meters must carry at least two independent navigation systems.</description>
        
    <applicableTypes>MotorSailor, Catamaran, Cruiser, Yacht, Trimaran, Ketch</applicableTypes>
        
    <effectiveDate>2024-02-12</effectiveDate>
        
    <penalty>Mandatory retrofit order</penalty>
      
  </regulation>
    
  <regulation id="R107">
        
    <title>Storm Readiness Kit</title>
        
    <description>Every vessel must carry an approved storm readiness kit during the monsoon season.</description>
        
    <applicableTypes>All</applicableTypes>
        
    <effectiveDate>2023-11-01</effectiveDate>
        
    <penalty>Fine and restricted departure clearance</penalty>
      
  </regulation>
    
  <regulation id="R108">
        
    <title>Mandatory Crew Safety Briefing</title>
        
    <description>Before departure, the captain must complete a documented safety briefing for all crew.</description>
        
    <applicableTypes>All</applicableTypes>
        
    <effectiveDate>2021-01-05</effectiveDate>
        
    <penalty>Administrative fine</penalty>
      
  </regulation>
    
